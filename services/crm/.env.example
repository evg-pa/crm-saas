# CRM Backend — Environment Variables
# Copy to .env for local development without Docker

# Database
DATABASE_URL=postgresql+asyncpg://crm_user:crm_pass@localhost:5432/crm_db
DATABASE_URL_SYNC=postgresql+psycopg2://crm_user:crm_pass@localhost:5432/crm_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — change in production!
JWT_SECRET_KEY=development-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["*"]

# Debug
DEBUG=false
