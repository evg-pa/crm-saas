# =============================================================================
# CRM SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# For local development with Docker Compose, the defaults work out of the box.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_pass
POSTGRES_DB=crm_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Backend — FastAPI
# ---------------------------------------------------------------------------
BACKEND_PORT=8000

# JWT Authentication
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=development-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — allowed origins (JSON array). Use ["*"] to allow all origins.
CORS_ORIGINS=["http://localhost:3000"]

# Logging format — "text" (human-readable) or "json" (structured, for log aggregation)
LOG_FORMAT=text

# Debug mode — set to "true" to enable SQL query logging
DEBUG=false

# ---------------------------------------------------------------------------
# Frontend — Next.js
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
# Backend URL for server-side API proxy (used by Next.js rewrites in Docker).
# In Docker Compose this defaults to http://backend:8000 (the internal service name).
# For local development without Docker, set to http://localhost:8000.
API_URL=http://localhost:8000
