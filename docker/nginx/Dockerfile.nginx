# =============================================================================
# CRM SaaS — Nginx Reverse Proxy (Production)
# =============================================================================
# Minimal production nginx image with custom config.
# Uses the official nginx:alpine base for a small (~10 MB) image.
# =============================================================================

FROM nginx:1.27-alpine

# Remove default config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy our production nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Note: nginx -t is skipped at build time because upstream hostnames
# (backend, frontend) are not resolvable until Docker Compose runtime.
# The config is validated in CI via a dry-run compose up.

# Create cache/log directories with correct permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx && \
    chmod -R 755 /var/cache/nginx /var/log/nginx

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
